---
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { articles, articleHref, categories } from '../../data/articles';
---

<Base
  title="Resources | UNAWA"
  description="Articles on e-notarization, e-signatures, AML compliance and digital transformation for Philippine organizations."
>
  <SiteNav />

  <main id="main-content" class="lib">
    <div class="container">
      <p class="eyebrow">Resources</p>
      <h1 class="lib__title">Everything we have written</h1>
      <p class="lib__lede">
        {articles.length} articles on e-notarization, e-signatures, AML compliance
        and running a Philippine business on digital rails.
      </p>

      <!-- Filtering is client-side over markup that is already complete, so the
           full list is in the HTML for search engines and for anyone without JS. -->
      <div class="lib__filters" role="group" aria-label="Filter by topic">
        <button class="chip" data-filter="all" aria-pressed="true">
          All <span class="chip__n">{articles.length}</span>
        </button>
        {categories.map((c) => (
          <button class="chip" data-filter={c.slug} aria-pressed="false">
            {c.label} <span class="chip__n">{c.count}</span>
          </button>
        ))}
      </div>

      <p class="lib__count" data-count role="status"></p>

      <ul class="lib__grid">
        {articles.map((a) => (
          <li class="card" data-category={a.category}>
            <a class="card__link" href={articleHref(a)}>
              <img
                class="card__img"
                src={a.image.src}
                alt={a.image.alt}
                width={a.image.width}
                height={a.image.height}
                loading="lazy"
                decoding="async"
              />
              <span class="card__cat">{a.categoryLabel}</span>
              <h2 class="card__title">{a.title}</h2>
              <time class="card__date" datetime={a.datetime}>{a.date}</time>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>

  <SiteFooter />
</Base>

<style>
  .lib { padding-block: clamp(2rem, 1rem + 4vw, 3.5rem) clamp(3rem, 2rem + 5vw, 5rem); }

  .lib__title {
    margin-top: 0.75rem;
    font-size: var(--t-display-2);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .lib__lede {
    max-width: 60ch;
    margin-top: 1rem;
    font-size: var(--t-body-lg);
    line-height: 1.6;
    color: var(--ink-2);
  }

  .lib__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2.5rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--line, #e1e6f2);
    border-radius: 999px;
    background: transparent;
    font: inherit;
    font-size: var(--t-small);
    color: var(--ink-2);
    cursor: pointer;
  }

  .chip:hover { border-color: var(--malaya); color: var(--blue); }

  .chip[aria-pressed='true'] {
    background: var(--midnight);
    border-color: var(--midnight);
    color: #fff;
  }

  .chip__n { opacity: 0.6; font-variant-numeric: tabular-nums; }

  .lib__count {
    margin-top: 1rem;
    font-size: var(--t-small);
    color: var(--muted-2);
    min-height: 1.4em;
  }

  .lib__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2rem 1.75rem;
    margin-top: 1rem;
    padding: 0;
    list-style: none;
  }

  .card[hidden] { display: none; }

  .card__link { display: block; color: inherit; }

  .card__img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--malumanay, #eef4fc);
  }

  .card__cat {
    display: block;
    margin-top: 0.9rem;
    font-size: var(--t-small);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .card__title {
    margin-top: 0.4rem;
    font-size: var(--t-body-lg);
    line-height: 1.35;
    font-weight: 700;
    color: var(--ink);
  }

  .card__link:hover .card__title { color: var(--blue); }

  .card__date {
    display: block;
    margin-top: 0.4rem;
    font-size: var(--t-small);
    color: var(--muted-2);
  }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const cards = document.querySelectorAll<HTMLLIElement>('.card');
  const count = document.querySelector<HTMLElement>('[data-count]');

  function apply(filter: string) {
    let shown = 0;
    cards.forEach((card) => {
      const match = filter === 'all' || card.dataset.category === filter;
      card.hidden = !match;
      if (match) shown += 1;
    });
    chips.forEach((chip) => {
      chip.setAttribute('aria-pressed', String(chip.dataset.filter === filter));
    });
    if (count) {
      count.textContent =
        filter === 'all' ? '' : `Showing ${shown} article${shown === 1 ? '' : 's'}.`;
    }
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => apply(chip.dataset.filter ?? 'all'));
  });
</script>
