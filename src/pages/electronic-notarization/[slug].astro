---
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { articles, summarise } from '../../data/articles';

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const summary = summarise(article.body);
---

<Base title={`${article.title} — UNAWA`} description={summary}>
  <SiteNav />

  <main id="main-content" class="article">
    <div class="container article__inner">
      <nav class="article__crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/#resources">Resources</a>
      </nav>

      <p class="eyebrow">Electronic Notarization</p>
      <h1 class="article__title">{article.title}</h1>
      <p class="article__byline">
        <time datetime={article.datetime}>{article.date}</time>
        <span aria-hidden="true"> · </span>
        UNAWA
      </p>

      <img
        class="article__hero"
        src={article.image.src}
        alt=""
        width={article.image.width}
        height={article.image.height}
      />

      <!-- Body is our own content, lifted from our own CMS, not user input. -->
      <div class="article__body" set:html={article.body} />

      <a class="btn btn--outline article__back" href="/#resources">Back to resources</a>
    </div>
  </main>

  <SiteFooter />
</Base>

<style>
  .article { padding-block: clamp(2rem, 1rem + 4vw, 3.5rem) clamp(3rem, 2rem + 5vw, 5rem); }

  /* A measure, not the full 1200 grid: long-form wants ~70 characters. */
  .article__inner { max-width: 760px; }

  .article__crumbs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
    font-size: var(--t-small);
    color: var(--muted);
  }

  .article__crumbs a { color: var(--muted); }
  .article__crumbs a:hover { color: var(--blue); }

  .article__title {
    margin-top: 0.75rem;
    font-size: var(--t-display-2);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .article__byline {
    margin-top: 0.875rem;
    font-size: var(--t-small);
    color: var(--muted-2);
  }

  .article__hero {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 2rem;
    border-radius: var(--radius);
  }

  .article__body { margin-top: 2.5rem; }

  /* The body arrives as HTML from the old CMS, so these are element selectors
     rather than classes. Scoped styles do not reach set:html content, hence
     the :global wrapper. */
  .article__body :global(p) {
    margin-bottom: 1.25rem;
    font-size: var(--t-body-lg);
    line-height: 1.65;
    color: var(--ink-2);
  }

  .article__body :global(h2),
  .article__body :global(h3),
  .article__body :global(h4) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-size: var(--t-header);
    line-height: 1.3;
    font-weight: 700;
    color: var(--ink);
  }

  .article__body :global(ul),
  .article__body :global(ol) {
    margin: 0 0 1.5rem 1.25rem;
    padding-left: 0.75rem;
    list-style: disc;
  }

  .article__body :global(ol) { list-style: decimal; }

  .article__body :global(li) {
    margin-bottom: 0.5rem;
    font-size: var(--t-body-lg);
    line-height: 1.6;
    color: var(--ink-2);
  }

  .article__body :global(a) {
    color: var(--blue);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article__body :global(a:hover) { color: var(--malaya); }

  .article__body :global(strong),
  .article__body :global(b) { font-weight: 700; color: var(--ink); }

  .article__body :global(figure) { margin: 2rem 0; }

  .article__body :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }

  .article__back { margin-top: 3rem; }

  @media (max-width: 599px) {
    .article__body :global(p),
    .article__body :global(li) { font-size: var(--t-body); }
  }
</style>
