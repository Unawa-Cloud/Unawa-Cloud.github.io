---
// Shared shell for the policy pages lifted from the WordPress site. The bodies
// are our own published legal copy stored as HTML under src/legal, so they go
// in with set:html and are styled by element rather than by class.
import Base from './Base.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  updated: string;
  body: string;
}

const { title, description, updated, body } = Astro.props;
---

<Base title={`${title} | UNAWA`} description={description}>
  <SiteNav />

  <main id="main-content" class="legal">
    <div class="container legal__inner">
      <nav class="legal__crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span>{title}</span>
      </nav>

      <h1 class="legal__title">{title}</h1>
      <p class="legal__updated">{updated}</p>

      <div class="legal__body" set:html={body} />
    </div>
  </main>

  <SiteFooter />
</Base>

<style>
  .legal { padding-block: clamp(2rem, 1rem + 4vw, 3.5rem) clamp(3rem, 2rem + 5vw, 5rem); }

  /* A measure, not the full 1200 grid: dense legal prose wants ~70 characters. */
  .legal__inner { max-width: 760px; }

  .legal__crumbs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
    font-size: var(--t-small);
    color: var(--muted);
  }

  .legal__crumbs a { color: var(--muted); }
  .legal__crumbs a:hover { color: var(--blue); }

  .legal__title {
    font-size: var(--t-display-2);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .legal__updated {
    margin-top: 0.875rem;
    font-size: var(--t-small);
    color: var(--muted-2);
  }

  .legal__body { margin-top: 2.5rem; }

  /* Scoped styles do not reach set:html content, hence the :global wrapper. */
  .legal__body :global(p) {
    margin-bottom: 1.25rem;
    font-size: var(--t-body);
    line-height: 1.7;
    color: var(--ink-2);
  }

  .legal__body :global(h2) {
    margin-top: 2.75rem;
    margin-bottom: 1rem;
    font-size: var(--t-header);
    line-height: 1.3;
    font-weight: 700;
    color: var(--ink);
  }

  .legal__body :global(ul),
  .legal__body :global(ol) {
    margin: 0 0 1.5rem 1.25rem;
    padding-left: 0.75rem;
    list-style: disc;
  }

  .legal__body :global(ol) { list-style: decimal; }

  .legal__body :global(li) {
    margin-bottom: 0.5rem;
    font-size: var(--t-body);
    line-height: 1.65;
    color: var(--ink-2);
  }

  .legal__body :global(a) {
    color: var(--blue);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .legal__body :global(a:hover) { color: var(--malaya); }

  .legal__body :global(strong),
  .legal__body :global(b) { font-weight: 700; color: var(--ink); }
</style>
