---
import { support } from '../data/content';

/**
 * Posts to the public intake route in notarizeit-marketing-v2
 * (`app/api/support/route.ts`). That app holds no data of its own; it validates
 * and relays to support by email.
 *
 * Both values are build-time, so a build without them leaves the form inert and
 * says so rather than failing silently:
 *   PUBLIC_SUPPORT_ENDPOINT     the route's full URL
 *   PUBLIC_TURNSTILE_SITE_KEY   Cloudflare Turnstile, public by design
 */
const { fields, supportEmail } = support;
const endpoint = import.meta.env.PUBLIC_SUPPORT_ENDPOINT;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<section class="support ground-dark section" id="support">
  <div class="container support__inner">
    <div class="support__copy">
      <p class="eyebrow eyebrow--on-dark">{support.eyebrow}</p>
      <h2 class="display-2">Need help with a<br />request or issue?</h2>
      <p class="lede lede--on-dark support__body">{support.body}</p>
    </div>

    <form class="support__form" data-support-form>
      <div class="field">
        <label for="support-name">{fields.name.label}</label>
        <input
          id="support-name"
          name="name"
          type="text"
          required
          placeholder={fields.name.placeholder}
        />
      </div>

      <div class="field-row">
        <div class="field">
          <label for="support-email">{fields.email.label}</label>
          <input
            id="support-email"
            name="email"
            type="email"
            required
            placeholder={fields.email.placeholder}
          />
        </div>

        <div class="field">
          <label for="support-type">{fields.ticketType.label}</label>
          <select id="support-type" name="ticketType" required>
            <option value="">{fields.ticketType.placeholder}</option>
            {fields.ticketType.options.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
        </div>
      </div>

      <div class="field">
        <label for="support-message">{fields.message.label}</label>
        <textarea
          id="support-message"
          name="message"
          rows="5"
          placeholder={fields.message.placeholder}></textarea>
      </div>

      <!--
        The frame draws an "Attach a File" control. It is left out until the
        upload path exists: an unauthenticated public upload endpoint is a
        liability, and the intake route takes JSON only. See the README.
      -->

      <!-- Honeypot. Hidden from people and assistive tech, irresistible to bots. -->
      <div class="hp" aria-hidden="true">
        <label for="support-company">Company</label>
        <input id="support-company" name="company" type="text" tabindex="-1" autocomplete="off" />
      </div>

      {turnstileSiteKey && (
        <>
          {/*
            Turnstile resolves these callbacks as globals, by name, so they
            cannot live in the module script below: that one is deferred while
            api.js is async and may well run first. They only record what
            happened on the form and announce it; the module owns every line of
            copy, so the two cannot drift.

            Returning a non-falsy value from an error callback suppresses only
            Turnstile's own console logging, not the error box it draws in the
            widget, so the CSS hides that box once we have taken the message over.
          */}
          <script is:inline>
            (function () {
              // 200500 (iframe blocked) is retryable and retries every 8s
              // forever, so a blocked challenges.cloudflare.com would never
              // resolve on its own. Give up after the second attempt and say so.
              var GIVE_UP_AFTER = 2;
              var retries = 0;

              function mark(state) {
                var form = document.querySelector('[data-support-form]');
                if (!form) return;
                form.dataset.turnstile = state;
                form.dispatchEvent(new CustomEvent('turnstile:state'));
              }

              // Codes the docs mark retryable. Everything else is ours to fix:
              // a bad sitekey, or a hostname missing from Hostname Management.
              function retryable(code) {
                var c = String(code);
                return (
                  c.charAt(0) === '3' ||
                  c.charAt(0) === '6' ||
                  c === '110600' ||
                  c === '110620' ||
                  c === '200500'
                );
              }

              window.unawaTurnstileOk = function () {
                retries = 0;
                mark('ok');
              };

              // The script tag's own onerror, not a Turnstile feature: it is the
              // only signal when an extension blocks api.js outright, which the
              // widget cannot report because it never loads.
              window.unawaTurnstileBlocked = function () {
                mark('blocked');
              };

              window.unawaTurnstileError = function (code) {
                // 200100 is also non-retryable, but it is the visitor's clock
                // or cache, not our configuration, and they can fix it.
                if (String(code) === '200100') {
                  mark('clock');
                  return true;
                }
                if (!retryable(code)) {
                  console.warn('Turnstile is misconfigured for this hostname', code);
                  mark('config');
                  return true;
                }
                if (++retries >= GIVE_UP_AFTER) mark('unavailable');
                return true;
              };

              window.unawaTurnstileExpired = function () {
                mark('expired');
                if (window.turnstile) window.turnstile.reset();
              };

              window.unawaTurnstileTimeout = function () {
                mark('expired');
              };
            })();
          </script>

          <div
            class="cf-turnstile"
            data-sitekey={turnstileSiteKey}
            data-theme="dark"
            data-callback="unawaTurnstileOk"
            data-error-callback="unawaTurnstileError"
            data-expired-callback="unawaTurnstileExpired"
            data-timeout-callback="unawaTurnstileTimeout"></div>

          <script
            is:inline
            async
            defer
            src="https://challenges.cloudflare.com/turnstile/v0/api.js"
            onerror="unawaTurnstileBlocked()"
          ></script>
        </>
      )}

      <div class="support__actions">
        <button class="btn support__submit" type="submit">{support.submit}</button>
      </div>

      <p class="support__status" data-support-status role="status" hidden></p>
      <p class="support__fallback" data-support-fallback hidden>
        Or email <a href={`mailto:${supportEmail}`}>{supportEmail}</a> and we will
        pick it up from there.
      </p>
    </form>
  </div>
</section>

<style>
  .support__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  /* 450px reproduces the frame's three-line break, ending line 1 on "within 1" */
  .support__body { margin-top: 1.25rem; max-width: 450px; }

  .support__form { display: grid; gap: 1rem; }

  .field { display: grid; gap: 0.375rem; min-width: 0; }

  .field-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .field label,

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 0.6875rem 0.875rem;
    border: 1px solid var(--line-2);
    border-radius: var(--radius-sm);
    background: var(--white);
    color: var(--ink);
    font-size: var(--t-small);
  }

  .field textarea { resize: vertical; min-height: 118px; }

  .field input::placeholder,
  .field textarea::placeholder { color: var(--muted-2); opacity: 0.8; }

  .field select { appearance: none; padding-right: 2.25rem; }

  .field:has(select) { position: relative; }

  .field:has(select)::after {
    content: '';
    position: absolute;
    right: 0.875rem;
    bottom: 1.05rem;
    width: 9px;
    height: 9px;
    border-right: 1.8px solid var(--malaya);
    border-bottom: 1.8px solid var(--malaya);
    rotate: 45deg;
    pointer-events: none;
  }


  .hp {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .support__actions { display: flex; justify-content: flex-end; }

  .support__submit {
    min-height: 42px;
    padding-inline: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: rgba(255, 255, 255, 0.07);
    color: var(--white);
    font-size: var(--t-small);
  }

  .support__submit:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.12);
    border-color: var(--malaya);
  }

  /* The button now stays disabled while the human check is unusable, not just
     for the second a send takes, so it has to look it. */
  .support__submit:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .support__status {
    margin: 0;
    font-size: var(--t-small);
    color: var(--malaya);
  }

  .support__status[data-tone='error'] { color: #ffb4a8; }
  .support__status[data-tone='ok'] { color: var(--malaya); }

  .support__fallback {
    margin: 0;
    font-size: var(--t-small);
    color: rgba(255, 255, 255, 0.72);
  }

  .support__fallback a { color: var(--malaya); }

  /* Turnstile draws its own error box inside the widget and offers no way to
     suppress it, so the box goes when our own message takes its place. */
  .support__form[data-turnstile='blocked'] .cf-turnstile,
  .support__form[data-turnstile='config'] .cf-turnstile,
  .support__form[data-turnstile='unavailable'] .cf-turnstile,
  .support__form[data-turnstile='clock'] .cf-turnstile {
    display: none;
  }

  @media (max-width: 899px) {
    .support__inner { grid-template-columns: minmax(0, 1fr); }
    .field-row { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-support-form]');
  const status = document.querySelector<HTMLElement>('[data-support-status]');
  const fallback = form?.querySelector<HTMLElement>('[data-support-fallback]');
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const widget = form?.querySelector<HTMLElement>('.cf-turnstile');
  const endpoint = import.meta.env.PUBLIC_SUPPORT_ENDPOINT;

  const MESSAGES: Record<string, string> = {
    rate_limited: 'Too many requests from this network. Try again in a few minutes.',
    challenge_failed: 'We could not verify you are human. Reload the page and try again.',
    validation: 'Please check the fields above and try again.',
    too_large: 'That message is too long. Please shorten it and try again.',
  };

  /**
   * States the inline Turnstile callbacks record on the form. The three fatal
   * ones are shown the moment they happen, because the visitor cannot get past
   * them and should not have to discover that by submitting.
   */
  const TURNSTILE_MESSAGES: Record<string, string> = {
    blocked:
      'The human check could not load. An extension or your network is blocking ' +
      'challenges.cloudflare.com.',
    config: 'The human check is not set up correctly on our side. Sorry about that.',
    unavailable: 'The human check is not responding. Try reloading the page.',
    clock:
      'Your device clock looks wrong, which blocks the human check. Correct the ' +
      'date and time, then reload the page.',
    expired: 'The human check expired. Complete it again, then submit.',
    pending: 'Still checking that you are human. Give it a moment, then submit again.',
  };

  const FATAL = new Set(['blocked', 'config', 'unavailable', 'clock']);

  let sending = false;
  // Set while the status line is showing a Turnstile message, so a recovery can
  // clear it without wiping a success or a server error that came from elsewhere.
  let showingTurnstile = false;

  function show(text: string, tone: 'ok' | 'error', withFallback = false) {
    if (!status) return;
    status.hidden = false;
    status.textContent = text;
    status.dataset.tone = tone;
    if (fallback) fallback.hidden = !withFallback;
  }

  function showTurnstile(state: string, withFallback: boolean) {
    show(TURNSTILE_MESSAGES[state], 'error', withFallback);
    showingTurnstile = true;
  }

  function renderTurnstileState() {
    const state = form?.dataset.turnstile ?? '';
    if (FATAL.has(state)) {
      // Submitting cannot succeed without a token, so the button says so rather
      // than letting the visitor earn a 403 for it.
      showTurnstile(state, true);
      submit?.setAttribute('disabled', '');
      return;
    }

    // A token arrived after all, so undo the lockout and take down whatever the
    // failure said. Leaving it up tells the visitor the form is broken while the
    // submit button sits there working.
    if (!sending) submit?.removeAttribute('disabled');
    if (showingTurnstile && status) {
      status.hidden = true;
      status.textContent = '';
      if (fallback) fallback.hidden = true;
      showingTurnstile = false;
    }
  }

  // This module is deferred and the callbacks are not, so a state may already
  // be recorded by the time the listener attaches. Read it once on startup.
  form?.addEventListener('turnstile:state', renderTurnstileState);
  renderTurnstileState();

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!endpoint) {
      show('This form is not connected yet.', 'error', true);
      return;
    }

    const turnstileState = form.dataset.turnstile ?? '';
    if (FATAL.has(turnstileState)) {
      renderTurnstileState();
      return;
    }


    const data = new FormData(form);
    const turnstileToken = String(data.get('cf-turnstile-response') ?? '');

    // No token yet, with a widget on the page, means the check has not finished.
    // Posting anyway earns a 403 telling the visitor to reload, which does not
    // help; waiting a moment does.
    if (widget && !turnstileToken) {
      showTurnstile(turnstileState === 'expired' ? 'expired' : 'pending', false);
      return;
    }

    sending = true;
    showingTurnstile = false;
    submit?.setAttribute('disabled', '');
    show('Sending…', 'ok');

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: String(data.get('name') ?? ''),
          email: String(data.get('email') ?? ''),
          ticketType: String(data.get('ticketType') ?? ''),
          message: String(data.get('message') ?? ''),
          company: String(data.get('company') ?? ''),
          turnstileToken,
        }),
      });

      if (response.ok) {
        form.reset();
        show('Thanks. We will get back to you within 1 to 2 business days.', 'ok');
        return;
      }

      const body = await response.json().catch(() => ({}));
      const message = MESSAGES[body?.error];
      // Validation and length the visitor can fix; a rate limit lifts on its
      // own. Anything else is a dead end, so offer the mailto alongside it.
      const stuck = !message || body?.error === 'challenge_failed';
      show(message ?? 'Something went wrong. Please try again shortly.', 'error', stuck);
    } catch {
      // Network failure, or the browser blocked the request before it left.
      show('We could not reach the server. Check your connection and try again.', 'error', true);
    } finally {
      sending = false;
      submit?.removeAttribute('disabled');
      // Turnstile tokens are single use, so the widget has to be reset.
      (window as unknown as { turnstile?: { reset: () => void } }).turnstile?.reset();
    }
  });
</script>
