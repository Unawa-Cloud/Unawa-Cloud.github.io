---
import Icon from './Icon.astro';
import { footer } from '../data/content';

/**
 * Matches the footer the designer revised on 23 Nov 2026: UNAWA alone rather
 * than the NotarizeIT lockup, with the socials and legal links moved under the
 * address. The accreditation badges, the "Notarize online" prompt and the legal
 * disclaimer were all dropped from the frame.
 */
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brandcol">
      <img class="footer__logo" src="/brand/unawa.svg" alt="UNAWA" width="184" height="43" />

      <address class="footer__address">
        {footer.address.map((line) => <span>{line}</span>)}
      </address>

      <ul class="footer__social">
        {footer.social.map((item) => (
          <li>
            <a href={item.href} aria-label={item.name} target="_blank" rel="noopener noreferrer">
              <Icon name={item.icon} size={18} />
            </a>
          </li>
        ))}
      </ul>

      <ul class="footer__legal">
        {footer.legalLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer__newscol">
      <h2 class="footer__newstitle">{footer.newsletter.title}</h2>
      <p class="footer__newsbody">{footer.newsletter.body}</p>

      <form class="footer__form" data-newsletter-form>
        <label class="sr-only" for="newsletter-email">Email address</label>
        <input
          id="newsletter-email"
          name="email"
          type="email"
          required
          placeholder={footer.newsletter.placeholder}
        />
        <!-- Honeypot. Hidden from people and assistive tech, irresistible to bots. -->
        <div class="hp" aria-hidden="true">
          <label for="newsletter-company">Company</label>
          <input id="newsletter-company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <button class="btn btn--dark" type="submit">{footer.newsletter.submit}</button>
      </form>
      <p class="footer__formstatus" data-newsletter-status role="status" hidden></p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--paper);
    border-top: 1px solid var(--line);
    padding-block: clamp(2.5rem, 4vw, 3.5rem);
  }

  .footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
  }

  /* 24px puts the lockup at ~0.27 of the address line's width, which is the
     proportion the frame uses. */
  .footer__logo { height: 24px; width: auto; }

  .footer__address {
    display: grid;
    gap: 0.15rem;
    margin-top: 1.25rem;
    font-style: normal;
    font-size: var(--t-small);
    line-height: 1.5;
    color: var(--muted);
  }

  .footer__social {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
    color: var(--ink);
  }

  .footer__social a:hover { color: var(--blue); }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.25rem;
    font-size: var(--t-small);
    color: var(--muted);
  }

  .footer__legal a:hover { color: var(--blue); }

  .footer__newstitle {
    font-size: var(--t-body);
    font-weight: 700;
  }

  .footer__newsbody {
    margin-top: 0.375rem;
    font-size: var(--t-small);
    color: var(--muted);
  }

  .footer__form {
    display: flex;
    gap: 0.625rem;
    margin-top: 1rem;
  }

  .footer__form input {
    flex: 1;
    min-width: 0;
    max-width: 260px;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--line-2);
    border-radius: var(--radius-sm);
    background: var(--white);
    font-size: var(--t-small);
  }

  .footer__form .btn {
    min-height: 40px;
    padding-inline: 1rem;
    font-size: var(--t-small);
  }

  .hp {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .footer__formstatus {
    margin-top: 0.5rem;
    font-size: var(--t-small);
    color: var(--blue);
  }

  .footer__formstatus[data-tone='error'] { color: #b4231b; }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 899px) {
    .footer__inner { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-newsletter-form]');
  const status = document.querySelector<HTMLElement>('[data-newsletter-status]');
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const endpoint = import.meta.env.PUBLIC_SUBSCRIBE_ENDPOINT;

  const MESSAGES: Record<string, string> = {
    rate_limited: 'That is a few too many tries. Please come back in a little while.',
    validation: 'That address does not look right. Please check it and try again.',
    too_large: 'That address is too long.',
  };

  function show(text: string, tone: 'ok' | 'error') {
    if (!status) return;
    status.hidden = false;
    status.textContent = text;
    status.dataset.tone = tone;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!endpoint) {
      show('Subscriptions are not available right now. Email hello@unawa.asia to be added.', 'error');
      return;
    }

    const data = new FormData(form);

    submit?.setAttribute('disabled', '');
    show('Subscribing…', 'ok');

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: String(data.get('email') ?? ''),
          company: String(data.get('company') ?? ''),
        }),
      });

      if (response.ok) {
        form.reset();
        // The list is double opt-in, so nothing happens until they confirm.
        // Saying so here saves them wondering why no updates arrive.
        show('Almost there. Check your inbox and confirm the subscription.', 'ok');
        return;
      }

      const body = await response.json().catch(() => ({}));
      show(MESSAGES[body?.error] ?? 'We could not subscribe you just now. Please try again shortly.', 'error');
    } catch {
      // Network failure, or the browser blocked the request before it left.
      show('We could not reach the server. Check your connection and try again.', 'error');
    } finally {
      submit?.removeAttribute('disabled');
    }
  });
</script>
