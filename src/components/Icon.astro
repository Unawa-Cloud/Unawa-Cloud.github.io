---
/**
 * Inline icon set. Shapes are redrawn from the Figma frame rather than exported,
 * so they inherit `currentColor` and need no asset pipeline.
 */
export type IconName =
  | 'shield'
  | 'person'
  | 'lines'
  | 'bulb'
  | 'bolt'
  | 'check'
  | 'diamond'
  | 'spark'
  | 'folder'
  | 'dots'
  | 'mic'
  | 'camera'
  | 'hangup'
  | 'lock'
  | 'award'
  | 'facebook'
  | 'instagram'
  | 'linkedin'
  | 'image';

interface Props {
  name: IconName;
  size?: number | string;
  class?: string;
  label?: string;
}

const { name, size = 20, class: className, label } = Astro.props;
const a11y = label
  ? { role: 'img', 'aria-label': label }
  : { 'aria-hidden': 'true' };
const stroke = {
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': 1.6,
  'stroke-linecap': 'round' as const,
  'stroke-linejoin': 'round' as const,
};
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  xmlns="http://www.w3.org/2000/svg"
  {...a11y}
>
  {name === 'shield' && <path {...stroke} d="M12 3.2 19 6v5.4c0 4.2-2.8 7.3-7 9.4-4.2-2.1-7-5.2-7-9.4V6l7-2.8Z" />}

  {name === 'person' && (
    <Fragment>
      <circle {...stroke} cx="12" cy="8" r="3.4" />
      <path {...stroke} d="M5.5 20.2c.6-3.5 3.3-5.6 6.5-5.6s5.9 2.1 6.5 5.6" />
    </Fragment>
  )}

  {name === 'lines' && (
    <Fragment>
      <path {...stroke} d="M4 6.5h16M4 11h11M4 15.5h14M4 20h8" />
    </Fragment>
  )}

  {name === 'bulb' && (
    <Fragment>
      <path {...stroke} d="M12 3.5a5.5 5.5 0 0 0-3.3 9.9c.6.5.9 1.2.9 1.9v.4h4.8v-.4c0-.7.3-1.4.9-1.9A5.5 5.5 0 0 0 12 3.5Z" />
      <path {...stroke} d="M10 19h4M10.6 21.3h2.8" />
    </Fragment>
  )}

  {name === 'bolt' && <path fill="currentColor" d="M13.6 2 5 13.2h5.2L9.3 22 18.6 10.4h-5.5L13.6 2Z" />}

  {name === 'check' && (
    <path
      fill="currentColor"
      d="M20.3 4.4a1.7 1.7 0 0 0-2.4.2l-7.6 8.9-3.6-3.4a1.7 1.7 0 1 0-2.3 2.5l4.9 4.6c.7.7 1.8.6 2.4-.1l8.8-10.3a1.7 1.7 0 0 0-.2-2.4Z"
    />
  )}

  {name === 'diamond' && (
    <path
      fill="currentColor"
      d="M12 2.2 16.8 7 12 11.8 7.2 7 12 2.2Zm0 10.2L16.8 17 12 21.8 7.2 17 12 12.4Z"
    />
  )}

  {/* UNAWA four-petal spark used as the NotarizeIT mark */}
  {name === 'spark' && (
    <path
      fill="currentColor"
      d="M9.1 2h5.8l-.6 5 4.3-2.6 2.9 5-4.9 2.1 4.9 2.1-2.9 5L14.3 16l.6 5H9.1l.6-5-4.3 2.7-2.9-5L7.4 11.5 2.5 9.4l2.9-5L9.7 7l-.6-5Z"
    />
  )}

  {name === 'folder' && (
    <path {...stroke} d="M3.5 7.5c0-1.1.9-2 2-2h3.2c.6 0 1.2.3 1.6.8l.9 1.2h7.3c1.1 0 2 .9 2 2v7c0 1.1-.9 2-2 2H5.5c-1.1 0-2-.9-2-2v-9Z" />
  )}

  {name === 'dots' && (
    <Fragment>
      <circle fill="currentColor" cx="12" cy="5" r="1.7" />
      <circle fill="currentColor" cx="12" cy="12" r="1.7" />
      <circle fill="currentColor" cx="12" cy="19" r="1.7" />
    </Fragment>
  )}

  {name === 'mic' && (
    <Fragment>
      <rect {...stroke} x="9" y="3" width="6" height="11" rx="3" />
      <path {...stroke} d="M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v3" />
    </Fragment>
  )}

  {name === 'camera' && (
    <Fragment>
      <rect {...stroke} x="3" y="6.5" width="12" height="11" rx="2.5" />
      <path {...stroke} d="m15 11 5.5-3v8L15 13" />
    </Fragment>
  )}

  {name === 'hangup' && (
    <path
      fill="currentColor"
      d="M12 8.5c-3 0-5.8.7-8 2-1.1.7-1.4 2.1-.8 3.2l.7 1.1c.5.9 1.6 1.2 2.5.8l2.3-1a1.9 1.9 0 0 0 1.1-1.8v-1c1.4-.3 3-.3 4.4 0v1c0 .8.4 1.5 1.1 1.8l2.3 1c.9.4 2-.0 2.5-.8l.7-1.1c.6-1.1.3-2.5-.8-3.2-2.2-1.3-5-2-8-2Z"
    />
  )}

  {name === 'lock' && (
    <Fragment>
      <rect {...stroke} x="4.5" y="10.5" width="15" height="9.5" rx="2" />
      <path {...stroke} d="M8 10.5V8a4 4 0 0 1 8 0v2.5" />
    </Fragment>
  )}

  {name === 'award' && (
    <Fragment>
      <circle {...stroke} cx="12" cy="9" r="5.5" />
      <path {...stroke} d="m8.5 13.5-1.4 7 4.9-2.6 4.9 2.6-1.4-7" />
    </Fragment>
  )}

  {name === 'image' && (
    <Fragment>
      <rect {...stroke} x="3" y="5" width="18" height="14" rx="2" />
      <circle {...stroke} cx="8.5" cy="10" r="1.6" />
      <path {...stroke} d="m4 17 4.8-4.6a1.6 1.6 0 0 1 2.2 0L16 17M14 14.4l1.6-1.5a1.6 1.6 0 0 1 2.2 0L20 15" />
    </Fragment>
  )}

  {name === 'facebook' && (
    <path
      fill="currentColor"
      d="M12 2a10 10 0 0 0-1.6 19.9v-7h-2.5V12h2.5V9.8c0-2.5 1.5-3.9 3.7-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.7l-.4 2.9h-2.3v7A10 10 0 0 0 12 2Z"
    />
  )}

  {name === 'instagram' && (
    <Fragment>
      <rect {...stroke} x="3.2" y="3.2" width="17.6" height="17.6" rx="5" />
      <circle {...stroke} cx="12" cy="12" r="4" />
      <circle fill="currentColor" cx="17" cy="7" r="1.2" />
    </Fragment>
  )}

  {name === 'linkedin' && (
    <path
      fill="currentColor"
      d="M4.5 3.2a2.1 2.1 0 1 0 0 4.2 2.1 2.1 0 0 0 0-4.2ZM2.8 9h3.4v11.8H2.8V9Zm6 0h3.3v1.6c.5-.9 1.7-1.9 3.5-1.9 3 0 4.1 1.9 4.1 5v7.1h-3.4v-6.3c0-1.6-.6-2.6-2-2.6-1.1 0-1.8.8-2.1 1.5-.1.3-.1.7-.1 1v6.4H8.8V9Z"
    />
  )}
</svg>
