---
import { trust } from '../data/content';

/**
 * Every mark here is real artwork exported from the frame at 3x. Each is sized
 * by its own 1x dimensions rather than forced to a common height, because the
 * frame places them at their natural sizes.
 */
---

<section class="trust" aria-label="Accreditation and partners">
  <div class="container trust__inner">
    {trust.groups.map((group) => (
      <div class="trust__group">
        <p class="trust__label">{group.label}</p>
        <ul class="trust__items">
          {group.items.map((item) => (
            <li class={group.kind === 'seal' ? 'trust__seal' : 'trust__logo'}>
              <img
                class={group.kind === 'seal' ? 'trust__sealmark' : 'trust__logoimg'}
                src={item.logo.src}
                alt={group.kind === 'seal' ? 'Supreme Court of the Philippines' : item.name}
                width={item.logo.width}
                height={item.logo.height}
                style={group.kind === 'seal' ? undefined : `width:${item.logo.width}px`}
                loading="lazy"
              />
              {group.kind === 'seal' && <span>{item.name}</span>}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .trust {
    background: var(--malumanay);
    border-block: 1px solid var(--line);
  }

  .trust__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem clamp(1rem, 2.5vw, 2.25rem);
    min-height: 79px;
    padding-block: 1rem;
  }

  .trust__group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .trust__label {
    font-size: var(--t-eyebrow);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-2);
    white-space: nowrap;
  }

  .trust__items {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem 1rem;
  }

  .trust__logo { display: flex; align-items: center; }

  /* Exported at 3x, so the intrinsic size is three times the display size. The
     width comes from the data as an inline style; CSS must not set `width:auto`
     here or the browser falls back to the intrinsic pixels and the row wraps. */
  .trust__logoimg {
    height: auto;
    max-width: 100%;
    object-fit: contain;
  }

  .trust__seal {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--t-footnote);
    color: var(--muted-2);
  }

  .trust__sealmark { width: 28px; height: 28px; object-fit: contain; flex: none; }

  @media (max-width: 1023px) {
    .trust__inner { justify-content: flex-start; }
  }
</style>
