---
import { trust } from '../data/content';

/**
 * Every mark here is real artwork exported from the frame at 3x. Each is sized
 * by its own 1x dimensions rather than forced to a common height, because the
 * frame places them at their natural sizes.
 *
 * The award and backer marks link out, to the same destinations notarizeit.ph
 * uses. The accreditation seal does not: it names us, so there is nowhere for
 * it to go.
 */
---

<section class="trust" aria-label="Accreditation and partners">
  <div class="container trust__inner">
    {trust.groups.map((group) => (
      <div class="trust__group">
        <p class="trust__label">{group.label}</p>
        <ul class="trust__items">
          {group.items.map((item) =>
            group.kind === 'seal' ? (
              <li class="trust__seal">
                <img
                  class="trust__sealmark"
                  src={item.logo.src}
                  alt="Supreme Court of the Philippines"
                  width={item.logo.width}
                  height={item.logo.height}
                  loading="lazy"
                />
                <span>{item.name}</span>
              </li>
            ) : (
              <li class="trust__logo">
                <a
                  class="trust__link"
                  href={item.href}
                  target={item.href.startsWith('http') ? '_blank' : undefined}
                  rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                >
                  <img
                    class="trust__logoimg"
                    src={item.logo.src}
                    alt={item.name}
                    width={item.logo.width}
                    height={item.logo.height}
                    style={`width:${item.logo.width}px`}
                    loading="lazy"
                  />
                </a>
              </li>
            )
          )}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .trust {
    background: var(--malumanay);
    border-block: 1px solid var(--line);
  }

  .trust__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem clamp(1rem, 2.5vw, 2.25rem);
    min-height: 79px;
    padding-block: 1rem;
  }

  .trust__group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .trust__label {
    font-size: var(--t-eyebrow);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-2);
    white-space: nowrap;
  }

  .trust__items {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem 1rem;
  }

  .trust__logo { display: flex; align-items: center; }

  .trust__link {
    position: relative;
    display: flex;
    align-items: center;
    border-radius: var(--radius-sm);
    transition: opacity 0.15s ease;
  }

  /* Some marks are only 16px tall, well under the 24px minimum tap target. The
     overlay grows the hit area to at least that in both directions without
     taking up any space, so the row keeps the sizes the frame gives it. */
  .trust__link::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    width: max(100%, 24px);
    height: max(100%, 24px);
  }

  .trust__link:hover { opacity: 0.65; }

  .trust__link:focus-visible {
    outline: 2px solid var(--malaya);
    outline-offset: 3px;
  }

  /* Exported at 3x, so the intrinsic size is three times the display size. The
     width comes from the data as an inline style; CSS must not set `width:auto`
     here or the browser falls back to the intrinsic pixels and the row wraps. */
  .trust__logoimg {
    height: auto;
    max-width: 100%;
    object-fit: contain;
  }

  .trust__seal {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--t-footnote);
    color: var(--muted-2);
  }

  .trust__sealmark { width: 28px; height: 28px; object-fit: contain; flex: none; }

  @media (max-width: 1023px) {
    .trust__inner { justify-content: flex-start; }
  }
</style>
