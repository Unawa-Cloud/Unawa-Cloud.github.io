---
import { resources } from '../data/content';
---

<section class="resources section" id="resources">
  <div class="container">
    <p class="eyebrow">{resources.eyebrow}</p>
    <h2 class="display-2 resources__title">Tools and insights<br />for your team</h2>

    <ul class="resources__grid">
      {resources.items.map((item) => (
        <li class="rcard">
          <a class="rcard__media" href={item.href} tabindex="-1" aria-hidden="true">
            <img
              src={item.image.src}
              alt=""
              width={item.image.width}
              height={item.image.height}
              loading="lazy"
            />
          </a>
          <div class="rcard__body">
            <h3 class="rcard__title">{item.title}</h3>
            <p class="rcard__date">{item.date}</p>
            <a class="btn btn--dark rcard__cta" href={item.href}>
              {resources.cta}
              <span class="sr-only"> about {item.title}</span>
            </a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .resources { background: var(--paper); }

  .resources__title { max-width: 16ch; }

  .resources__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.75rem;
    margin-top: clamp(2.25rem, 4vw, 3.25rem);
  }

  .rcard {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--white);
    border: 1px solid var(--line);
  }

  .rcard__media {
    display: block;
    aspect-ratio: 16 / 9;
    background: #e3e6ec;
  }

  /* The thumbnails are 16:9 already, so cover only guards a future odd one. */
  .rcard__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rcard__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.25rem 1.25rem 1.5rem;
  }

  .rcard__title {
    max-width: 24ch;
    font-size: var(--t-body);
    line-height: 1.375;
    font-weight: 700;
  }

  .rcard__date {
    margin-top: 0.5rem;
    font-size: var(--t-small);
    color: var(--muted-2);
  }

  .rcard__cta {
    align-self: flex-start;
    margin-top: auto;
    margin-block-start: 1.5rem;
    min-height: 38px;
    padding-inline: 1.125rem;
    font-size: var(--t-small);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 899px) {
    .resources__grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
