---
import { whyTrust } from '../data/content';
---

<section class="why section" id="why">
  <div class="container">
    <p class="eyebrow">{whyTrust.eyebrow}</p>
    <h2 class="display-2">{whyTrust.title}</h2>

    <ul class="why__grid">
      {whyTrust.items.map((item) => (
        <li class="why__card">
          <h3 class="card-title why__cardtitle">{item.title}</h3>
          <p class="card-copy">{item.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .why { background: var(--peach); }

  .why__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .why__card {
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: 0 18px 40px -34px rgba(17, 17, 67, 0.55);
  }

  .why__cardtitle {
    max-width: 19ch;
    font-size: var(--t-body);
  }

  @media (max-width: 899px) {
    .why__grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
